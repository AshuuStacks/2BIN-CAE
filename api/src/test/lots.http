@baseUrl = http://localhost:3000

### Login to get token
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email": "producteur@gmail.be",
  "password": "Admin&123"
}



### Create a product (chou-fleur)
POST {{baseUrl}}/products/add
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "libelleProduct": "chou-fleur",
  "description": "Fresh cauliflower",
  "unite": { "unite": "Kg" },
  "productType": { "libelleType": "Légumes" }
}


### Create a product photo
POST {{baseUrl}}/photos/add
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="productId"

{{productId}}
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="image"; filename="cauliflower.jpg"
Content-Type: image/jpeg

< ./cauliflower.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

# Save the 'idPhoto' from the response as 'photoId' in env.json

### Create a lot (chou-fleur)
POST {{baseUrl}}/lots/add
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="newLot"

{
  "price": 7,
  "initialQuantity": 150,
  "productId": {{productId}},
  "producerId": {{producerId}},
  "lotStatus": "en vente",
  "availableDate": "2025-04-23",
  "photoId": {{photoId}},
  "soldQuantity": 0,
  "reservedQuantity": 0,
  "remainingQuantity": 150,
  "withdrawnQuantity": 0
}
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Get all lots
GET {{baseUrl}}/lots/all

### Get a specific lot
GET {{baseUrl}}/lots/5

### Get available lots
GET {{baseUrl}}/lots/available

### Get pending lots
GET {{baseUrl}}/lots/pending